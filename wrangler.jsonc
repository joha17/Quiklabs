// Cloudflare Workers: sitio estático (Vite → dist/). Sin código de servidor.
{
  "name": "quiklabs",
  "compatibility_date": "2026-10-01",
  // Compila antes de desplegar: `wrangler deploy` (también el de Workers Builds) genera dist/ con Vite.
  "build": {
    "command": "npm run build"
  },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
